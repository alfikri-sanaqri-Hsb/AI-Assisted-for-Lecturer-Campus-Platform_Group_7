# Port server
PORT=5000
NODE_ENV=development

# Database (MySQL lokal, mis. XAMPP: user root, password kosong)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sahabat_alfary
DB_PORT=3306

# JWT: ganti dengan teks acak panjang buatanmu sendiri. JANGAN commit file .env
JWT_SECRET=ganti-dengan-teks-acak-panjang
JWT_EXPIRE=7d

# CORS: alamat web (hanya satu origin)
FRONTEND_URL=http://localhost:3000

# AI: mock = jawaban contoh tanpa Gemini (gratis, cukup untuk develop)
#     gemini = pakai Gemini sungguhan (wajib isi GEMINI_API_KEY)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT_FREE=3
AI_DAILY_LIMIT_PREMIUM=10

# Keamanan
# Pembayaran: simulation (siswa menandai lunas sendiri, hanya untuk demo) atau off (matikan)
PAYMENT_MODE=simulation
# Batas percobaan: login per 15 menit (per IP+email), register per jam (per IP)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
# Isi 1 kalau di belakang proxy/hosting
# TRUST_PROXY=1
